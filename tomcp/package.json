{
  "name": "@hivehub/umicp2mcp",
  "version": "0.1.3",
  "description": "MCP Bridge for UMICP - Execute UMICP calls through Model Context Protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "umicp2mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "node --test",
    "publish:wsl": "export BROWSER=wslview && npm publish"
  },
  "keywords": [
    "umicp",
    "mcp",
    "model-context-protocol",
    "bridge",
    "hivellm"
  ],
  "author": "HiveLLM",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@hivehub/umicp-sdk": "^0.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hivellm/hivellm.git",
    "directory": "umicp/tomcp"
  },
  "publishConfig": {
    "access": "public"
  }
}
