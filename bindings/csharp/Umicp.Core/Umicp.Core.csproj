<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package Metadata -->
    <PackageId>HiveLLM.Umicp</PackageId>
    <Version>0.2.0</Version>
    <Authors>HiveLLM Team</Authors>
    <Company>HiveLLM</Company>
    <Product>UMICP C# SDK</Product>
    <Description>Universal Matrix Intelligent Communication Protocol (UMICP) - Production-ready C# bindings for high-performance AI model communication with tool discovery. Features SIMD-accelerated matrix operations, WebSocket/HTTP transport, compression, peer-to-peer multiplexing, service discovery, connection pooling, and MCP-compatible tool discovery.</Description>
    <Copyright>Copyright (c) 2025 HiveLLM</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hivellm/umicp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hivellm/umicp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umicp;ai;communication;protocol;websocket;matrix;simd;compression;p2p;hivellm;machine-learning;interoperability</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>v0.2.0: Tool Discovery + Native Types. Features: MCP-compatible tool discovery (IDiscoverableService interface), native JSON types in capabilities (Dictionary&lt;string, object&gt;), JSON Schema support, operation introspection. BREAKING: No breaking changes (C# already had object type support). 114 tests passing.</PackageReleaseNotes>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn><!-- Suppress missing XML doc warnings for now -->

    <!-- Symbol Package -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Build -->
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>

    <!-- Code Quality -->
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageReference Include="System.Text.Json" Version="9.0.9" />

    <!-- Code Analysis -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- SourceLink -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\..\Logo-HiveLLM-512x512.png" Pack="true" PackagePath="\icon.png" />
  </ItemGroup>

</Project>
