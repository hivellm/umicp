{
  "name": "@hivellm/umicp",
  "version": "0.2.1",
  "description": "UMICP TypeScript/JavaScript bindings with native types and MCP-compatible tool discovery",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "build:native": "node-gyp rebuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist node_modules",
    "clean:all": "rm -rf dist build node_modules *.node",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit",
    "lint:fix": "tsc --noEmit --fix",
    "dev": "npm run build && npm run test:watch",
    "build:debug": "tsc && node-gyp rebuild --debug",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:regression",
    "test:unit": "vitest run test/envelope.test.ts test/matrix.test.ts",
    "test:integration": "echo 'Integration tests skipped (require WebSocket infrastructure or mocks)' && vitest run test/e2e.test.ts",
    "test:s2s": "vitest run test/s2s.test.ts",
    "test:websocket": "vitest run test/websocket-transport.test.ts",
    "test:security": "vitest run test/security.test.ts",
    "test:regression": "vitest run test/regression.test.ts",
    "test:load": "vitest run test/load.test.ts",
    "test:performance": "vitest run --testNamePattern=\"Performance|Load\"",
    "test:ci": "npm run test:all && npm run test:load",
    "test:quick": "vitest run test/envelope.test.ts test/matrix.test.ts",
    "docs": "typedoc --out docs --name 'UMICP TypeScript Bindings' src/index.ts",
    "benchmark": "node examples/benchmark.js",
    "coverage:report": "npm run test:coverage && open coverage/lcov-report/index.html",
    "quality": "npm run lint && npm run test:all && npm run test:coverage",
    "publish:wsl": "export BROWSER=wslview && npm publish"
  },
  "dependencies": {
    "node-addon-api": "^7.0.0",
    "ws": "^8.14.2"
  },
  "peerDependencies": {
    "@cmmv/http": ">=0.5.0",
    "@cmmv/server": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@cmmv/http": {
      "optional": true
    },
    "@cmmv/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/ws": "^8.5.8",
    "@vitest/ui": "^1.6.1",
    "node-gyp": "^10.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hivellm/umicp.git"
  },
  "bugs": {
    "url": "https://github.com/hivellm/umicp/issues"
  },
  "homepage": "https://github.com/hivellm/umicp#readme",
  "files": [
    "dist/",
    "build/Release/umicp_core.node",
    "src/",
    "examples/",
    "README.md",
    "package.json",
    "binding.gyp",
    "tsconfig.json",
    "tsconfig.cjs.json",
    "tsconfig.esm.json"
  ],
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "keywords": [
    "umicp",
    "ai",
    "communication",
    "protocol",
    "matrix",
    "embeddings",
    "federated-learning",
    "server-to-server",
    "typescript",
    "cpp",
    "bindings",
    "native",
    "performance",
    "simd"
  ],
  "author": "HiveLLM AI Collaborative Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
