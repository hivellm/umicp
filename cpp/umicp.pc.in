prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: UMICP
Description: Universal Matrix Intelligent Communication Protocol
Version: @PROJECT_VERSION@
URL: https://github.com/hivellm/umicp

Requires: openssl
Libs: -L${libdir} -lumicp
Libs.private: -lpthread -ldl
Cflags: -I${includedir}
