{
  "name": "umicp",
  "version": "0.1.1",
  "description": "Universal Matrix Intelligent Communication Protocol - High-performance communication protocol for AI model interoperability",
  "homepage": "https://github.com/hivellm/umicp",
  "license": "MIT",
  "supports": "!uwp",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "nlohmann-json",
    "openssl",
    "websocketpp",
    "asio",
    "curl"
  ],
  "features": {
    "websocket": {
      "description": "Enable WebSocket transport",
      "dependencies": [
        "websocketpp",
        "asio"
      ]
    },
    "http": {
      "description": "Enable HTTP transport",
      "dependencies": [
        "curl"
      ]
    },
    "tests": {
      "description": "Build tests",
      "dependencies": [
        "gtest"
      ]
    }
  }
}

